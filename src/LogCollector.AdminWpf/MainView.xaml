<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FB">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#245CDA"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17243B"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="2" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#0F2347"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#D8E0ED"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#D8E0ED"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserSortColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="White"/><Setter Property="RowHeight" Value="32"/>
      <Setter Property="ColumnHeaderHeight" Value="48"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
      <Setter Property="ColumnWidth" Value="*"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="#EEF3FB"/>
      <Setter Property="Foreground" Value="#52647F"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#52647F"/></DataTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,5"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="#E1E7F1"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="#14233E" Padding="26,17">
    <Grid><StackPanel><TextBlock Text="Сбор и фильтрация логов" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="Панель администратора распределённой системы" Foreground="#B4C5E4" Margin="0,5,0,0"/></StackPanel>
      <Border Background="#263D62" CornerRadius="14" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="TCP  ·  .NET Framework 4.8" Foreground="#DBE7FF" FontSize="12"/></Border>
    </Grid>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="22,12,22,0" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><Label Content="_Адрес сервера" Target="{Binding ElementName=HostBox}" Padding="0,0,0,5"/>
        <TextBox x:Name="HostBox" Text="127.0.0.1" MaxLength="255"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><Label Content="_Порт" Target="{Binding ElementName=PortBox}" Padding="0,0,0,5"/>
        <TextBox x:Name="PortBox" Text="5050" MaxLength="5"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,12,0"><Label Content="_Токен администратора" Target="{Binding ElementName=TokenBox}" Padding="0,0,0,5"/>
        <PasswordBox x:Name="TokenBox" MaxLength="1024"/></StackPanel>
      <Button Grid.Column="3" x:Name="ConnectButton" Content="Подключить" VerticalAlignment="Bottom"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="4" x:Name="ConnectionLabel" Text="Укажите адрес сервера и токен для подключения" TextWrapping="Wrap" Foreground="#52647F" Margin="0,12,0,0"/>
    </Grid>
  </Border>
  <UniformGrid Grid.Row="2" Columns="4" Margin="22,10,14,10">
    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="ПОЛУЧЕНО" FontSize="11" Foreground="#52647F"/>
      <TextBlock x:Name="ReceivedValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="СОХРАНЕНО" FontSize="11" Foreground="#52647F"/>
      <TextBlock x:Name="StoredValue" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#147A5A" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="ОТФИЛЬТРОВАНО" FontSize="11" Foreground="#52647F"/>
      <TextBlock x:Name="FilteredValue" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#996217" Margin="0,5,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="ОШИБОК ЗАПИСИ" FontSize="11" Foreground="#52647F"/>
      <TextBlock x:Name="FailedValue" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#B33A48" Margin="0,5,0,0"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="3" x:Name="MainTabs" Margin="22,0,22,0" Background="White" BorderBrush="#E1E7F1">
    <TabItem Header="Источники и статистика">
      <Grid Margin="16,12" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><TextBlock Text="Управление источниками" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="AutoRefreshBox" Content="Обновлять раз в секунду" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="RefreshButton" Content="Обновить" Background="#EDF3FF" Foreground="#245CDA" MinHeight="34" Padding="14,5"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="SourceGrid"><DataGrid.Columns>
              <DataGridTextColumn Header="Источник" Binding="{Binding Name}" Width="1.4*"/>
              <DataGridTextColumn Header="Минимум" Binding="{Binding Minimum}" Width="*"/>
              <DataGridTextColumn Header="Подключений" Binding="{Binding ActiveConnections}" Width="*"/>
            </DataGrid.Columns></DataGrid>
            <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
              <Label Content="_Источник" Target="{Binding ElementName=SourceBox}" Padding="0,0,0,5"/>
              <Label Grid.Column="1" Content="_Минимум" Target="{Binding ElementName=MinimumBox}" Padding="0,0,0,5"/>
              <TextBox x:Name="SourceBox" Grid.Row="1" MaxLength="128" Margin="0,0,10,0" ToolTip="Выберите строку выше или введите имя нового источника"/>
              <ComboBox x:Name="MinimumBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0"/>
              <Button Grid.Row="1" Grid.Column="2" x:Name="ApplyButton" Content="Применить"/>
            </Grid>
          </Grid>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="LevelGrid"><DataGrid.Columns>
              <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="*"/>
              <DataGridTextColumn Header="Получено" Binding="{Binding Received, StringFormat=N0}" Width="*"/>
              <DataGridTextColumn Header="Сохранено" Binding="{Binding Stored, StringFormat=N0}" Width="*"/>
              <DataGridTextColumn Header="Отсеяно" Binding="{Binding Filtered, StringFormat=N0}" Width="*"/>
              <DataGridTextColumn Header="Ошибок записи" Binding="{Binding Failed, StringFormat=N0}" Width="*"/>
            </DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="1" Text="Счётчики по пяти уровням с момента запуска сервера" TextWrapping="Wrap" Foreground="#52647F" Margin="0,10,0,0"/>
          </Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="TotalsLabel" Text="Данные появятся после подключения к серверу" Margin="0,10,0,0" Foreground="#52647F"/>
      </Grid>
    </TabItem>
    <TabItem Header="События администратора"><Grid Margin="16" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12"><TextBlock Text="История действий текущего окна" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Подтверждения операций и ошибки подключения. Токен в историю не записывается." Margin="0,6,0,0" Foreground="#52647F" TextWrapping="Wrap"/></StackPanel>
      <TextBox Grid.Row="1" x:Name="EventBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#F8FAFD"/>
    </Grid></TabItem>
  </TabControl>
  <Grid Grid.Row="4" Margin="26,0"><TextBlock x:Name="StatusLabel" Text="Отключено" VerticalAlignment="Center" Foreground="#52647F"/>
    <TextBlock x:Name="UpdatedLabel" Text="Обновление: —" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#52647F"/></Grid>
</Grid>
